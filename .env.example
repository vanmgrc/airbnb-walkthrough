# Copy this file to .env.local for local development.
# In Vercel, add these under Project Settings > Environment Variables instead.

# Your Anthropic API key, from console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Your OpenAI API key, from platform.openai.com.
# Only needed if you want to use the ChatGPT option instead of Claude.
OPENAI_API_KEY=

# The password you'll use to open the app (pick your own)
SITE_PASSWORD=
